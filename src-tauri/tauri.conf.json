{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veyra",
  "version": "0.1.0",
  "identifier": "com.veyra.desktop",
  "build": {
    "beforeDevCommand": "npm run tauri:dev:frontend",
    "beforeBuildCommand": "npm run tauri:build:frontend",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Veyra",
        "width": 1480,
        "height": 940,
        "minWidth": 1050,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:5173; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "resources": ["resources/backend"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ],
    "targets": ["deb", "rpm", "appimage", "nsis", "dmg"],
    "category": "Utility",
    "shortDescription": "Adaptive semantic LiDAR mapping",
    "longDescription": "Veyra adaptive variable-resolution semantic 2.5D LiDAR mapping"
  }
}
