{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veyra",
  "version": "0.1.0",
  "identifier": "com.veyra.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run tauri:dev:frontend",
      "cwd": "../apps/desktop"
    },
    "beforeBuildCommand": {
      "script": "npm run tauri:build:frontend",
      "cwd": "../apps/desktop"
    },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Veyra",
        "width": 1480,
        "height": 940,
        "minWidth": 1050,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc://localhost http://ipc.localhost ws://127.0.0.1:*; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "resources": ["resources/backend"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "targets": ["deb", "rpm", "appimage", "nsis", "dmg"],
    "macOS": {
      "signingIdentity": "-"
    },
    "category": "Utility",
    "shortDescription": "Adaptive semantic LiDAR mapping",
    "longDescription": "Veyra adaptive variable-resolution semantic 2.5D LiDAR mapping"
  }
}
