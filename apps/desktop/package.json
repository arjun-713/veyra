{
  "name": "veyra-desktop",
  "productName": "Veyra",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptive semantic LiDAR mapping desktop",
  "author": "Veyra contributors",
  "license": "MIT",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test":
        "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.ts",
    "build": "vite build --config vite.renderer.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "svelte": "^5.0.0",
    "three": "^0.183.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.0",
    "@electron-forge/maker-deb": "^7.11.0",
    "@electron-forge/maker-dmg": "^7.11.0",
    "@electron-forge/maker-squirrel": "^7.11.0",
    "@electron-forge/maker-zip": "^7.11.0",
    "@electron-forge/plugin-vite": "^7.11.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.183.0",
    "electron": "^40.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
