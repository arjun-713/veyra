{
  "name": "veyra-desktop",
  "productName": "Veyra",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptive semantic LiDAR mapping desktop",
  "author": "Veyra contributors",
  "license": "MIT",
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.ts",
    "build": "vite build --config vite.renderer.config.ts",
    "test:e2e": "playwright test",
    "tauri:dev:frontend": "vite --config vite.renderer.config.ts --host 127.0.0.1",
    "tauri:build:frontend": "vite build --config vite.renderer.config.ts",
    "tauri:dev": "node ../../tools/tauri.mjs dev --config src-tauri/tauri.conf.json",
    "tauri:build": "node ../../tools/tauri.mjs build --config src-tauri/tauri.conf.json"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "svelte": "^5.0.0",
    "three": "^0.183.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.0.0",
    "@types/three": "^0.183.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
